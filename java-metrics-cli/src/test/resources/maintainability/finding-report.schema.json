{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetricsTree maintainability findings, version 2",
  "type": "object",
  "required": [
    "schemaVersion",
    "toolVersion",
    "status",
    "summary",
    "findings",
    "issues"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "v2"
      ]
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Which build produced this report. Present in every document so a bug report can be matched to the run that made it; '0.0.0-dev' is the honest value for an unversioned run."
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED",
        "INCOMPLETE"
      ]
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "enabledRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enforcement": {
      "type": "string",
      "enum": [
        "ADVISORY",
        "ENFORCE"
      ]
    },
    "comparison": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "base",
        "mergeBase",
        "head"
      ],
      "properties": {
        "base": {
          "type": "string"
        },
        "mergeBase": {
          "type": "string"
        },
        "head": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "description": "What the analysis established about its own coverage. Absent when the caller has none to give, which is not the same as a run that measured nothing: absent means not reported, and the counters inside it mean reported and zero. A report that cannot distinguish the two is asking a reader to infer a coverage claim that was never made.",
      "properties": {
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "incomplete"
          ],
          "description": "'complete' only when nothing at all was missing, optional gaps included. A partial run that reported a gap and a complete run that happened to need no gap are different, and a reader deciding whether to trust a verdict needs the difference."
        },
        "eligibleFiles": {
          "type": "integer",
          "minimum": 0
        },
        "analyzedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "excludedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checksEvaluated": {
          "type": "integer",
          "minimum": 0
        },
        "checksUnavailable": {
          "type": "integer",
          "minimum": 0
        },
        "requiredGaps": {
          "type": "integer",
          "minimum": 0
        },
        "optionalGaps": {
          "type": "integer",
          "minimum": 0
        },
        "execution": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/issue"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "activeFindings",
        "blocking",
        "existing",
        "suppressed",
        "baselineAccepted",
        "resolved",
        "total",
        "entities",
        "issues",
        "requiredIssues"
      ],
      "properties": {
        "activeFindings": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "integer",
          "minimum": 0
        },
        "existing": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        },
        "baselineAccepted": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "entities": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "integer",
          "minimum": 0
        },
        "requiredIssues": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/issue"
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/suppression"
      }
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "required": [
        "ruleId",
        "ruleVersion",
        "fingerprint",
        "ruleTitle",
        "message",
        "severity",
        "maturity",
        "evaluationStatus",
        "lifecycle",
        "disposition",
        "entityKey",
        "location",
        "evidence",
        "blocking"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^MT-[MC][0-9]{3}$"
        },
        "ruleVersion": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "previousFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ruleTitle": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "maturity": {
          "type": "string",
          "enum": [
            "CANDIDATE",
            "EXPERIMENTAL",
            "VALIDATED"
          ]
        },
        "evaluationStatus": {
          "type": "string",
          "enum": [
            "COMPLETE_MATCH",
            "COMPLETE_NONMATCH",
            "PARTIAL_NONMATCH",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "NONE",
            "NEW_ENTITY",
            "INTRODUCED",
            "WORSENED",
            "EXISTING",
            "CURRENT",
            "RESOLVED",
            "COMPARISON_UNAVAILABLE"
          ],
          "description": "What the comparison showed, or that there was none. NEW_ENTITY, INTRODUCED and WORSENED assert something about a change and are the only lifecycles eligible to block. CURRENT is a match at a revision with nothing to compare it against: a current-only run cannot know whether the code is new, so it reports what matched without claiming a history."
        },
        "disposition": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "EXISTING",
            "SUPPRESSED",
            "BASELINE_ACCEPTED",
            "RESOLVED",
            "NOT_MATCHED"
          ]
        },
        "dispositionReason": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "PRODUCTION",
            "TEST",
            "GENERATED",
            "DTO",
            "ADAPTER",
            "UNKNOWN"
          ]
        },
        "entityKey": {
          "type": "object",
          "required": [
            "path",
            "qualifiedName"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "qualifiedName": {
              "type": "string",
              "minLength": 1
            },
            "signature": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "baseLocation": {
          "type": [
            "object",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "relatedLocations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/location"
          }
        },
        "remediationHint": {
          "type": "string"
        },
        "documentationPath": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "path",
        "startLine",
        "endLine"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "metric",
        "unit"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": [
            "number",
            "null"
          ]
        },
        "after": {
          "type": [
            "number",
            "null"
          ]
        },
        "delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "completenessReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contributions": {
          "type": "array",
          "description": "Where the value came from, as recorded during analysis. Empty when tracing was not requested: an absent trace is a legitimate report, never a guessed one.",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "amount",
              "line"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "suppression": {
      "type": "object",
      "required": [
        "ruleId",
        "entity",
        "reason",
        "state"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expiresOn": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "applied",
            "expired",
            "stale",
            "unused"
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "reasonCode",
        "message",
        "required"
      ],
      "properties": {
        "ruleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "entityKey": {
          "type": [
            "object",
            "null"
          ]
        },
        "location": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}
